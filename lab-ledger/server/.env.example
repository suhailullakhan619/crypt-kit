# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Demo mode ─────────────────────────────────────────────────────────────────
# true  → in-memory MongoDB + auto-seeded demo users/data (no other setup needed)
# false → MONGODB_URI and JWT_SECRET are required
DEMO_MODE=true

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/crypt-kit

# ── Auth ──────────────────────────────────────────────────────────────────────
# Minimum 32 characters when DEMO_MODE is not true.
JWT_SECRET=

# ── Email (optional) ───────────────────────────────────────────────────────
# Any SMTP service works (Amazon SES, Brevo, Resend, Gmail app password...).
# Leave these empty to keep notifications in-app only.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients. With SES this must be a verified address or domain.
MAIL_FROM=
# Optional: where replies go (useful when MAIL_FROM is a no-reply address).
MAIL_REPLY_TO=

# Optional: an owner account created at startup as the superuser, next to the demo accounts.
# Keep the password here (this file is not committed), never in crypt.config.js.
# SEED_ADMIN_EMAIL=you@example.com
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Your Name

