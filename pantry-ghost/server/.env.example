# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Demo mode ─────────────────────────────────────────────────────────────────
# true  → in-memory MongoDB + auto-seeded demo users/data (no other setup needed)
# false → MONGODB_URI and JWT_SECRET are required
DEMO_MODE=true

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/crypt-kit

# ── Auth ──────────────────────────────────────────────────────────────────────
# Minimum 32 characters when DEMO_MODE is not true.
JWT_SECRET=

# ── Voice ─────────────────────────────────────────────────────────────────────
# Optional. With a key, the server uses Whisper + TTS; without, the browser's Web Speech API.
OPENAI_API_KEY=
# openai | browser   (defaults to openai when OPENAI_API_KEY is set, else browser)
VOICE_PROVIDER=

# Optional: use a different database on the same cluster (overrides the name in the URI), e.g. pantry-ghost_test.
MONGODB_DB_NAME=
# Optional: seed demo data on boot. Only allowed when MONGODB_DB_NAME ends in "_test".
SEED_ON_BOOT=false
# Optional (hosting): keep demo mode's data in MONGODB_URI instead of an in-memory database, for
# hosts that cannot run mongod (Render, Railway...). Requires MONGODB_DB_NAME ending in "_demo" or "_test".
DEMO_PERSIST=false
# Set to true behind a reverse proxy (Render, Railway, Heroku) so rate limits see visitor addresses.
TRUST_PROXY=false


# ── Email (optional) ───────────────────────────────────────────────────────
# Any SMTP service works (Amazon SES, Brevo, Resend, Gmail app password...).
# Leave these empty to keep notifications in-app only.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients. With SES this must be a verified address or domain.
MAIL_FROM=
# Optional: where replies go (useful when MAIL_FROM is a no-reply address).
MAIL_REPLY_TO=

# Optional: an owner account created at startup as the superuser, next to the demo accounts.
# Keep the password here (this file is not committed), never in crypt.config.js.
# SEED_ADMIN_EMAIL=you@example.com
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Your Name

