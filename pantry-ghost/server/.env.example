# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Demo mode ─────────────────────────────────────────────────────────────────
# true  → in-memory MongoDB + auto-seeded demo users/data (no other setup needed)
# false → MONGODB_URI and JWT_SECRET are required
DEMO_MODE=true

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/crypt-kit

# ── Auth ──────────────────────────────────────────────────────────────────────
# Minimum 32 characters when DEMO_MODE is not true.
JWT_SECRET=

# ── Voice ─────────────────────────────────────────────────────────────────────
# Optional. With a key, the server uses Whisper + TTS; without, the browser's Web Speech API.
OPENAI_API_KEY=
# openai | browser   (defaults to openai when OPENAI_API_KEY is set, else browser)
VOICE_PROVIDER=
