{
  "name": "pantry-ghost-server",
  "version": "0.1.0",
  "description": "Pantry Ghost API — food bank inventory raised from the Crypt Kit skeleton",
  "type": "module",
  "main": "src/server.js",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/cli.js",
    "smoke": "node scripts/smoke.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.1.4",
    "mongoose": "^8.9.5",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "openai": "^4.80.0",
    "pdfkit": "^0.16.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testTimeout": 120000,
    "projects": [
      {
        "displayName": "skeleton",
        "testEnvironment": "node",
        "transform": {},
        "testMatch": [
          "<rootDir>/src/**/*.test.js"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/src/domain/",
          "/src/resources/",
          "/src/intents/",
          "/src/dashboard/",
          "/src/jobs/app/",
          "/src/routes/app/",
          "/src/services/(distribution|intake|impact|expiry)Service",
          "/test/"
        ],
        "moduleNameMapper": {
          "^(\\.\\./)+crypt\\.config\\.js$": "<rootDir>/test/fixtures/skeleton/crypt.config.js",
          "^\\.\\./resources/notes\\.js$": "<rootDir>/test/fixtures/skeleton/notes.js"
        }
      },
      {
        "displayName": "pantry",
        "testEnvironment": "node",
        "transform": {},
        "testMatch": [
          "<rootDir>/src/domain/**/*.test.js",
          "<rootDir>/src/resources/**/*.test.js",
          "<rootDir>/src/intents/**/*.test.js",
          "<rootDir>/src/dashboard/**/*.test.js",
          "<rootDir>/src/jobs/app/**/*.test.js",
          "<rootDir>/src/routes/app/**/*.test.js",
          "<rootDir>/src/services/distributionService*.test.js",
          "<rootDir>/src/services/intakeService*.test.js",
          "<rootDir>/src/services/impactService*.test.js",
          "<rootDir>/src/services/expiryService*.test.js",
          "<rootDir>/test/**/*.test.js"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/test/fixtures/",
          "/test/generators/"
        ]
      }
    ]
  }
}
